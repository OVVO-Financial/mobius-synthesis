{
  // Ctrl+Shift+B / Cmd+Shift+B runs "Lean: CI mirror build" as the default.
  //
  // Use it instead of the Lean extension's plain build. The plain build runs
  // `lake build` only: it never restores the Mathlib cache, never runs the
  // source audit, and never runs the axiom gate. Those are the checks a green
  // local run has historically skipped on its way to a red hosted run.
  //
  // This mirrors the "Baseline audit" job in mobius-synthesis.
  //
  // Requires bash on PATH. On Windows that means Git Bash (installed with
  // Git for Windows and with GitHub Desktop).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lean: CI mirror build",
      "detail": "Audit + Mathlib cache + lake build RHLean --wfail + axiom gate",
      "type": "process",
      "command": "bash",
      "args": ["scripts/local_ci.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "lean",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(error|warning): (.+\\.lean):(\\d+):(\\d+): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Lean: quick build",
      "detail": "Mathlib cache + lake build RHLean --wfail, no audits. For iteration only.",
      "type": "process",
      "command": "bash",
      "args": ["-c", "lake exe cache get && lake build RHLean --wfail"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "lean",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(error|warning): (.+\\.lean):(\\d+):(\\d+): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    }
  ]
}
